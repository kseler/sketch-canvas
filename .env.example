# Copy to .env and fill in. Never commit .env and never expose these keys to the browser.
ANTHROPIC_API_KEY=
IMAGE_API_KEY=

# Daily spending caps in US dollars (UTC days), enforced by the cost wrapper before every paid call.
# DAILY_BUDGET_USD covers the whole server; ROOM_BUDGET_USD covers one room.
DAILY_BUDGET_USD=2.00
ROOM_BUDGET_USD=0.50

# Web pages allowed to call the API from a browser (CORS), comma-separated, no trailing slash.
# Defaults to the Vite dev server, http://localhost:5173. Add the address you actually open if it differs
# (another port, 127.0.0.1, a LAN IP), or Generate gets 403. Set it to the real address when deployed.
ALLOWED_ORIGINS=http://localhost:5173
